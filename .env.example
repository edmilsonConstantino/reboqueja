AUTH_COOKIE_NAME=rj_session
AUTH_SECRET=troque-por-uma-string-longa-e-aleatoria

# Postgres alojado (obrigatorio no Vercel). Localmente use o mesmo URL:
# o SQLite em ficheiro nao funciona em serverless (FS so de leitura).
#
# DATABASE_URL -> ligacao usada pela aplicacao (no Neon/Supabase: a *pooled*,
#                 porta 6543, com ?pgbouncer=true&connection_limit=1)
# DIRECT_URL   -> ligacao directa, sem pooler (porta 5432), so para
#                 `prisma db push` e migracoes
DATABASE_URL="postgresql://utilizador:senha@ep-xxxx-pooler.us-east-2.aws.neon.tech/reboqueja?sslmode=require&pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://utilizador:senha@ep-xxxx.us-east-2.aws.neon.tech/reboqueja?sslmode=require"
